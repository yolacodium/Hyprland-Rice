{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty-direct",
    "source": "/home/guts/Pictures/wallhaven-vp2dxl.png",
    "width": 18,
    "height": 9,
    "padding": { "top": 1, "left": 1, "right": 2 }
  },

  "display": {
    "separator": "  ",
    "color": { "keys": "blue", "title": "magenta" }
  },

  "modules": [
    "title",
    { "type": "break" },
    { "type": "os",       "key": "os"   },
    { "type": "wm",       "key": "wm"   },
    { "type": "shell",    "key": "sh"   },
    { "type": "terminal", "key": "term" },
    { "type": "cpu",      "key": "cpu"  },
    { "type": "gpu",      "key": "gpu"  }, 
    { "type": "memory",   "key": "mem"  },
    { "type": "uptime",   "key": "up"   },
    { "type": "break" },
    { "type": "colors", "symbol": "circle" }
  ]
}

